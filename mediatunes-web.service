[Unit]
# Web frontend for moongas mediatunes: plain Deno.serve server that serves the
# Vue SPA (client/dist) and proxies /api/* and /getfile/* to the backend
# (mediatunes-svc).
#
# Prerequisites:
#   1. Deno installed (https://deno.com/) — set ExecStart below to the output of
#      `which deno` on the target host (commonly ~/.deno/bin/deno or /usr/bin/deno).
#   2. Frontend built: run `deno task build` in the repo so client/dist exists.
Description=mediatunes-web-vue (Deno/Vue SPA server / frontend)
After=network.target

[Service]
User=root
Group=root
WorkingDirectory=/var/www/moongas/moongas-collection-demo/moongas-mediatunes-web-vue
# Environment for server/main.ts (see file header for details):
#   PORT              listen port (default 8000)
#   BACKEND_URL       backend base URL
#   BACKEND_URL_PREFIX  path prefix the backend's JSON API is served under
#   PUBLIC_BASE_PATH  public base path the SPA is served under (default /mediatunes)
Environment=PORT=8000
Environment=BACKEND_URL=http://127.0.0.1:5000
Environment=BACKEND_URL_PREFIX=/api
Environment=PUBLIC_BASE_PATH=/mediatunes
ExecStart=/usr/bin/deno run --allow-net --allow-read --allow-env server/main.ts
Restart=always
RestartSec=30s
Type=simple

[Install]
WantedBy=multi-user.target
