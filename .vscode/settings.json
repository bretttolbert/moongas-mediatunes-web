{
    "deno.enable": true,
    "files.associations": {
        "*.service": "ini"
    },
    "files.exclude": {
        "**/.git": true,
        "**/node_modules": true
    },
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/node_modules/*/**": true
    },
    "search.exclude": {
        "**/node_modules": true,
        "**/dist": true
    }
}
