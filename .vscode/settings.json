{
    "deno.enable": true,
    "files.associations": {
        "*.service": "ini"
    },
    "files.exclude": {
        "**/.env*": true,
        "**/.venv*": true,
        "**/.git": true,
        "**/node_modules": true
    },
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/node_modules/*/**": true,
        "**/.venv/**": true,
        "**/.venv.*/**": true
    },
    "search.exclude": {
        "**/node_modules": true,
        "**/bower_components": true,
        "**/.venv": true,
        "**/.venv.*": true,
        "**/build": true,
        "**/dist": true
    },
    "explorer.excludeGitIgnore": false,
    "search.useIgnoreFiles": false
}
