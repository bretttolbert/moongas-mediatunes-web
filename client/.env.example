# Copy to .env and adjust for your setup.
# Local dev-server settings for the Vite proxy (loaded by vite.config.ts).

# Base URL of the mediatunes-svc backend (JSON API + media files).
BACKEND_URL=http://127.0.0.1:5000

# Must match serverConfig.urlPrefix in mediatunes-config.yml (empty when unset).
# Example when urlPrefix is /api:
# BACKEND_URL_PREFIX=/api
BACKEND_URL_PREFIX=
